        "def preprocess_text(text: str) -> str:\n",
        "    \"\"\"Lowercase and trim punctuation for simple matching.\"\"\"\n",
        "    text = text.lower().strip()\n",
        "    return text\n",
        "\n",
        "def match_intent(text: str):\n",
        "    \"\"\"Return the best matching intent key, or 'fallback'.\"\"\"\n",
        "    text_p = preprocess_text(text)\n",
        "    # Check specific intents first (order matters for specificity)\n",
        "    for intent, data in INTENTS.items():\n",
        "        if intent == \"assignment_deadline\":\n",
        "            # handle assignment_deadline specially below\n",
        "            continue\n",
        "        patterns = data.get(\"patterns\", [])\n",
        "        for pat in patterns:\n",
        "            if re.search(pat, text_p):\n",
        "                return intent\n",
        "    # assignment_deadline - check for 'assignment' or 'due' words\n",
        "    if re.search(r\"\\b(assignment|homework|task)\\b\", text_p) and re.search(r\"\\b(due|deadline|when)\\b\", text_p):\n",
        "        return \"assignment_deadline\"\n",
        "    # fallback\n",
        "    return \"fallback\"\n",
        "\n",
        "# Simple dynamic deadline example data (in a real bot you'd query a DB)\n",
        "NEXT_ASSIGNMENT = {\n",
        "    \"title\": \"Assignment 3: Data preprocessing\",\n",
        "    \"due\": datetime.now().date() + timedelta(days=6),  # 6 days from now\n",
        "    \"notes\": \"Submit on the LMS before 11:59 PM. Late submissions lose 10% per day.\"\n",
        "}\n",
        "\n",
        "def format_deadline_response():\n",
        "    due_date = NEXT_ASSIGNMENT[\"due\"]\n",
        "    days_left = (due_date - datetime.now().date()).days\n",
        "    if days_left < 0:\n",
        "        info = f\"The deadline for {NEXT_ASSIGNMENT['title']} was {due_date.strftime('%b %d, %Y')} (already passed). {NEXT_ASSIGNMENT['notes']}\"\n",
        "    elif days_left == 0:\n",
        "        info = f\"{NEXT_ASSIGNMENT['title']} is due today ({due_date.strftime('%b %d, %Y')}). {NEXT_ASSIGNMENT['notes']}\"\n",
        "    else:\n",
        "        info = f\"{NEXT_ASSIGNMENT['title']} is due on {due_date.strftime('%b %d, %Y')} — that's in {days_left} day(s). {NEXT_ASSIGNMENT['notes']}\"\n",
        "    return info\n",
        "\n",
        "def get_response(user_text: str) -> str:\n",
        "    intent = match_intent(user_text)\n",
        "    if intent == \"assignment_deadline\":\n",
        "        return format_deadline_response()\n",
        "    responses = INTENTS.get(intent, INTENTS[\"fallback\"])[\"responses\"]\n",
        "    return random.choice(responses)"
      ],
