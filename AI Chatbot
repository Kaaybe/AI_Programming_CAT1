        "def chat_loop():\n",
        "    print(\"Course Assistant Bot (type 'help' for capabilities, 'exit' to quit)\\n\")\n",
        "    while True:\n",
        "        try:\n",
        "            user = input(\"You: \").strip()\n",
        "        except (EOFError, KeyboardInterrupt):\n",
        "            print(\"\\nExiting. Goodbye!\")\n",
        "            break\n",
        "        if not user:\n",
        "            print(\"Bot: Please type a message or 'help' to see options.\")\n",
        "            continue\n",
        "        if re.search(r\"\\b(exit|quit|bye|goodbye)\\b\", user.lower()):\n",
        "            print(\"Bot:\", random.choice(INTENTS[\"goodbye\"][\"responses\"]))\n",
        "            break\n",
        "        resp = get_response(user)\n",
        "        print(\"Bot:\", resp)"
