      "source": [
        "import pandas as pd\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "np.random.seed(0)\n",
        "df = pd.DataFrame({\n",
        "    'student_id': range(1, 101),\n",
        "    'hours_studied': np.random.normal(5, 2, 100).clip(0),\n",
        "    'assignment_score': np.random.normal(75, 10, 100).clip(0,100),\n",
        "    'exam_score': np.random.normal(70, 12, 100).clip(0,100)\n",
        "})\n",
        "\n",
        "# Clean\n",
        "df = df.drop_duplicates()\n",
        "df['hours_studied'] = df['hours_studied'].fillna(df['hours_studied'].median())"
      ],
      "metadata": {
        "id": "OrD88N5VeagV"
      },
      "execution_count": 2,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# Simple stats\n",
        "print(\"Summary:\\n\", df.describe())\n",
        "print(\"\\nCorrelation between hours studied and exam score:\\n\", df['hours_studied'].corr(df['exam_score']))"
      ],
