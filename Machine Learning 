        "\"\"\"\n",
        "Machine Learning Student Performance Predictor\n",
        "Implements both Linear Regression and Decision Tree models\n",
        "\"\"\"\n",
        "\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "from sklearn.model_selection import train_test_split, cross_val_score\n",
        "from sklearn.linear_model import LinearRegression\n",
        "from sklearn.tree import DecisionTreeRegressor\n",
        "from sklearn.metrics import mean_squared_error, r2_score, mean_absolute_error\n",
        "from sklearn.preprocessing import StandardScaler\n",
        "import warnings\n",
        "warnings.filterwarnings('ignore')\n",
        "\n",
        "class MLPerformancePredictor:\n",
        "    \"\"\"\n",
        "    A machine learning system that predicts student performance using\n",
        "    both Linear Regression and Decision Tree algorithms.\n",
        "    \"\"\"\n",
        "\n",
        "    def __init__(self):\n",
        "        \"\"\"Initialize the ML predictor.\"\"\"\n",
        "        self.data = None\n",
        "        self.X_train = None\n",
        "        self.X_test = None\n",
        "        self.y_train = None\n",
        "        self.y_test = None\n",
        "        self.scaler = StandardScaler()\n",
        "        self.lr_model = None\n",
        "        self.dt_model = None\n",
        "        self.feature_names = None\n",
        "\n",
        "    def create_dataset(self):\n",
        "        \"\"\"\n",
        "        Create a comprehensive student performance dataset.\n",
        "        \"\"\"\n",
        "        np.random.seed(42)\n",
        "        n_students = 500\n",
        "\n",
        "        # Generate features\n",
        "        study_hours = np.random.normal(5, 2, n_students).clip(0, 12)\n",
        "        attendance = np.random.normal(85, 10, n_students).clip(50, 100)\n",
        "        previous_grade = np.random.normal(75, 12, n_students).clip(40, 100)\n",
        "        sleep_hours = np.random.normal(7, 1.5, n_students).clip(4, 10)\n",
        "        assignments_completed = np.random.normal(90, 8, n_students).clip(50, 100)\n",
        "        participation = np.random.normal(75, 15, n_students).clip(30, 100)\n",
        "\n",
        "        # Create target with realistic relationships\n",
        "        final_grade = (\n",
        "            study_hours * 3.5 +\n",
        "            attendance * 0.4 +\n",
        "            previous_grade * 0.3 +\n",
        "            sleep_hours * 1.5 +\n",
        "            assignments_completed * 0.25 +\n",
        "            participation * 0.15 +\n",
        "            np.random.normal(0, 5, n_students)  # Add noise\n",
        "        )\n",
        "\n",
        "        # Normalize to 0-100 scale\n",
        "        final_grade = ((final_grade - final_grade.min()) /\n",
        "                      (final_grade.max() - final_grade.min()) * 100)\n",
        "\n",
        "        # Create DataFrame\n",
        "        self.data = pd.DataFrame({\n",
        "            'StudyHours': study_hours,\n",
        "            'AttendanceRate': attendance,\n",
        "            'PreviousGrade': previous_grade,\n",
        "            'SleepHours': sleep_hours,\n",
        "            'AssignmentsCompleted': assignments_completed,\n",
        "            'ParticipationScore': participation,\n",
        "            'FinalGrade': final_grade\n",
        "        })\n",
        "\n",
        "        print(\"✓ Dataset created successfully!\")\n",
        "        print(f\"  Total samples: {len(self.data)}\")\n",
        "        print(f\"  Features: {len(self.data.columns) - 1}\")\n",
        "\n",
        "        return self.data\n",
        "\n",
        "    def explore_data(self):\n",
        "        \"\"\"\n",
        "        Explore and visualize the dataset.\n",
        "        \"\"\"\n",
        "        print(\"\\n\" + \"=\"*70)\n",
        "        print(\"DATA EXPLORATION\")\n",
        "        print(\"=\"*70)\n",
        "\n",
        "        print(\"\\n📊 Dataset Overview:\")\n",
        "        print(self.data.head(10))\n",
        "\n",
        "        print(\"\\n📈 Statistical Summary:\")\n",
        "        print(self.data.describe())\n",
        "\n",
        "        print(\"\\n🔗 Feature Correlations with Final Grade:\")\n",
        "        correlations = self.data.corr()['FinalGrade'].sort_values(ascending=False)\n",
        "        for feature, corr in correlations.items():\n",
        "            if feature != 'FinalGrade':\n",
        "                print(f\"   • {feature}: {corr:.3f}\")\n",
        "\n",
        "        # Visualize correlations\n",
        "        plt.figure(figsize=(12, 8))\n",
        "\n",
        "        # Correlation matrix\n",
        "        plt.subplot(2, 2, 1)\n",
        "        sns.heatmap(self.data.corr(), annot=True, fmt='.2f', cmap='coolwarm',\n",
        "                   square=True, cbar_kws={'shrink': 0.8})\n",
        "        plt.title('Feature Correlation Matrix')\n",
        "\n",
        "        # Distribution of target variable\n",
        "        plt.subplot(2, 2, 2)\n",
        "        plt.hist(self.data['FinalGrade'], bins=30, color='skyblue', edgecolor='black')\n",
        "        plt.axvline(self.data['FinalGrade'].mean(), color='red',\n",
        "                   linestyle='--', label=f'Mean: {self.data[\"FinalGrade\"].mean():.2f}')\n",
        "        plt.title('Distribution of Final Grades')\n",
        "        plt.xlabel('Final Grade')\n",
        "        plt.ylabel('Frequency')\n",
        "        plt.legend()\n",
        "\n",
        "        # Study Hours vs Grade\n",
        "        plt.subplot(2, 2, 3)\n",
        "        plt.scatter(self.data['StudyHours'], self.data['FinalGrade'], alpha=0.5)\n",
        "        plt.title('Study Hours vs Final Grade')\n",
        "        plt.xlabel('Study Hours per Week')\n",
        "        plt.ylabel('Final Grade')\n",
        "\n",
        "        # Attendance vs Grade\n",
        "        plt.subplot(2, 2, 4)\n",
        "        plt.scatter(self.data['AttendanceRate'], self.data['FinalGrade'],\n",
        "                   alpha=0.5, color='green')\n",
        "        plt.title('Attendance Rate vs Final Grade')\n",
        "        plt.xlabel('Attendance Rate (%)')\n",
        "        plt.ylabel('Final Grade')\n",
        "\n",
        "        plt.tight_layout()\n",
        "        plt.savefig('data_exploration.png', dpi=300, bbox_inches='tight')\n",
        "        plt.show()\n",
        "\n",
        "        print(\"\\n✅ Exploration visualizations saved as 'data_exploration.png'\")\n",
        "\n",
        "    def prepare_data(self, test_size=0.2, random_state=42):\n",
        "        \"\"\"\n",
        "        Prepare data for machine learning by splitting into train/test sets.\n",
        "\n",
        "        Args:\n",
        "            test_size (float): Proportion of data for testing\n",
        "            random_state (int): Random seed for reproducibility\n",
        "        \"\"\"\n",
        "        print(\"\\n\" + \"=\"*70)\n",
        "        print(\"DATA PREPARATION\")\n",
        "        print(\"=\"*70)\n",
        "\n",
        "        # Separate features and target\n",
        "        X = self.data.drop('FinalGrade', axis=1)\n",
        "        y = self.data['FinalGrade']\n",
        "\n",
        "        self.feature_names = X.columns.tolist()\n",
        "\n",
        "        # Split data\n",
        "        self.X_train, self.X_test, self.y_train, self.y_test = train_test_split(\n",
        "            X, y, test_size=test_size, random_state=random_state\n",
        "        )\n",
        "\n",
        "        print(f\"\\n✓ Data split completed:\")\n",
        "        print(f\"   • Training samples: {len(self.X_train)} ({(1-test_size)*100:.0f}%)\")\n",
        "        print(f\"   • Testing samples: {len(self.X_test)} ({test_size*100:.0f}%)\")\n",
        "        print(f\"   • Features: {len(self.feature_names)}\")\n",
        "\n",
        "        # Scale features for better performance\n",
        "        self.X_train_scaled = self.scaler.fit_transform(self.X_train)\n",
        "        self.X_test_scaled = self.scaler.transform(self.X_test)\n",
        "\n",
        "        print(f\"\\n✓ Feature scaling applied (StandardScaler)\")\n",
        "\n",
        "    def train_linear_regression(self):\n",
        "        \"\"\"\n",
        "        Train Linear Regression model.\n",
        "        \"\"\"\n",
        "        print(\"\\n\" + \"=\"*70)\n",
        "        print(\"TRAINING LINEAR REGRESSION MODEL\")\n",
        "        print(\"=\"*70)\n",
        "\n",
        "        # Initialize and train model\n",
        "        self.lr_model = LinearRegression()\n",
        "        self.lr_model.fit(self.X_train_scaled, self.y_train)\n",
        "\n",
        "        print(\"\\n✓ Model trained successfully!\")\n",
        "\n",
        "        # Display feature importance (coefficients)\n",
        "        print(\"\\n📊 Feature Coefficients:\")\n",
        "        coefficients = pd.DataFrame({\n",
        "            'Feature': self.feature_names,\n",
        "            'Coefficient': self.lr_model.coef_\n",
        "        }).sort_values('Coefficient', key=abs, ascending=False)\n",
        "\n",
        "        for idx, row in coefficients.iterrows():\n",
        "            print(f\"   • {row['Feature']}: {row['Coefficient']:.4f}\")\n",
        "\n",
        "        # Cross-validation\n",
        "        cv_scores = cross_val_score(self.lr_model, self.X_train_scaled,\n",
        "                                    self.y_train, cv=5,\n",
        "                                    scoring='neg_mean_squared_error')\n",
        "        cv_rmse = np.sqrt(-cv_scores.mean())\n",
        "\n",
        "        print(f\"\\n🔄 Cross-Validation RMSE: {cv_rmse:.2f}\")\n",
        "\n",
        "    def train_decision_tree(self, max_depth=5):\n",
        "        \"\"\"\n",
        "        Train Decision Tree model.\n",
        "\n",
        "        Args:\n",
        "            max_depth (int): Maximum depth of the tree\n",
        "        \"\"\"\n",
        "        print(\"\\n\" + \"=\"*70)\n",
        "        print(\"TRAINING DECISION TREE MODEL\")\n",
        "        print(\"=\"*70)\n",
        "\n",
        "        # Initialize and train model\n",
        "        self.dt_model = DecisionTreeRegressor(\n",
        "            max_depth=max_depth,\n",
        "            min_samples_split=20,\n",
        "            min_samples_leaf=10,\n",
        "            random_state=42\n",
        "        )\n",
        "        self.dt_model.fit(self.X_train_scaled, self.y_train)\n",
        "\n",
        "        print(f\"\\n✓ Model trained successfully!\")\n",
        "        print(f\"   • Max depth: {max_depth}\")\n",
        "        print(f\"   • Total nodes: {self.dt_model.tree_.node_count}\")\n",
        "        print(f\"   • Tree depth: {self.dt_model.tree_.max_depth}\")\n",
        "\n",
        "        # Display feature importance\n",
        "        print(\"\\n📊 Feature Importance:\")\n",
        "        importances = pd.DataFrame({\n",
        "            'Feature': self.feature_names,\n",
        "            'Importance': self.dt_model.feature_importances_\n",
        "        }).sort_values('Importance', ascending=False)\n",
        "\n",
        "        for idx, row in importances.iterrows():\n",
        "            print(f\"   • {row['Feature']}: {row['Importance']:.4f}\")\n",
        "\n",
        "        # Cross-validation\n",
        "        cv_scores = cross_val_score(self.dt_model, self.X_train_scaled,\n",
        "                                    self.y_train, cv=5,\n",
        "                                    scoring='neg_mean_squared_error')\n",
        "        cv_rmse = np.sqrt(-cv_scores.mean())\n",
        "\n",
        "        print(f\"\\n🔄 Cross-Validation RMSE: {cv_rmse:.2f}\")\n",
        "\n",
        "    def evaluate_models(self):\n",
        "        \"\"\"\n",
        "        Evaluate both models on test data.\n",
        "        \"\"\"\n",
        "        print(\"\\n\" + \"=\"*70)\n",
        "        print(\"MODEL EVALUATION\")\n",
        "        print(\"=\"*70)\n",
        "\n",
        "        # Linear Regression predictions\n",
        "        lr_pred_train = self.lr_model.predict(self.X_train_scaled)\n",
        "        lr_pred_test = self.lr_model.predict(self.X_test_scaled)\n",
        "\n",
        "        # Decision Tree predictions\n",
        "        dt_pred_train = self.dt_model.predict(self.X_train_scaled)\n",
        "        dt_pred_test = self.dt_model.predict(self.X_test_scaled)\n",
        "\n",
        "        # Calculate metrics\n",
        "        models_performance = {\n",
